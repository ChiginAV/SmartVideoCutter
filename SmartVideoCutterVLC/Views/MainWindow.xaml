<Window
    x:Class="SmartVideoCutterVLC.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ib="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="Smart video cutter"
    Width="1200"
    Height="720"
    MinWidth="800"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Меню  -->
        <Menu Grid.Row="0" Grid.ColumnSpan="2">
            <MenuItem Header="Файл">
                <MenuItem
                    Command="{Binding OpenFileCommand}"
                    Header="Открыть"
                    InputGestureText="Ctrl+O" />
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Command="{Binding OpenSettingsCommand}" Header="Настройки" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" />
            </MenuItem>
        </Menu>

        <!--  Видео с оверлеем через VideoView.Content (аппаратно поверх видео)  -->
        <vlc:VideoView x:Name="VideoView"
            Grid.Row="2"
            MediaPlayer="{Binding MediaPlayer}">
            <vlc:VideoView.Content>
                <Canvas x:Name="OverlayCanvas"
                    Background="Transparent"
                    IsHitTestVisible="False" />
            </vlc:VideoView.Content>
        </vlc:VideoView>

        <DockPanel
            Grid.Row="3"
            Height="50"
            VerticalAlignment="Center">
            <Button x:Name="PlayPauseButton"
                Width="90"
                Margin="5"
                Command="{Binding PlayPauseCommand}"
                Content="Play/Pause"
                DockPanel.Dock="Left" />
            <Slider x:Name="TimeSlider"
                Margin="5"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                IsMoveToPointEnabled="True"
                IsSnapToTickEnabled="True"
                Maximum="{Binding MaxPosition}"
                Minimum="0"
                Value="{Binding Position, Mode=TwoWay}">
                <ib:Interaction.Triggers>
                    <ib:EventTrigger EventName="MouseLeftButtonDown">
                        <ib:InvokeCommandAction Command="{Binding DragStartedCommand}" />
                    </ib:EventTrigger>
                    <ib:EventTrigger EventName="MouseLeftButtonUp">
                        <ib:InvokeCommandAction Command="{Binding DragCompletedCommand}" />
                    </ib:EventTrigger>
                </ib:Interaction.Triggers>
            </Slider>
        </DockPanel>

        <DockPanel
            Grid.Row="1"
            Grid.Column="1"
            Height="40"
            Margin="0,5,5,0"
            DockPanel.Dock="Top"
            LastChildFill="False">
            <Button x:Name="AnalyzeButton"
                Width="90"
                Margin="0,0,5,5"
                Command="{Binding AnalyzeFileCommand}"
                Content="Analyze"
                DockPanel.Dock="Left" />
            <Button x:Name="ExportButton"
                Width="90"
                Margin="0,0,0,5"
                Command="{Binding ExportFileCommand}"
                Content="Export"
                DockPanel.Dock="Right" />
        </DockPanel>

        <DataGrid
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,5,0"
            AutoGenerateColumns="False"
            CanUserSortColumns="False"
            DockPanel.Dock="Bottom"
            ItemsSource="{Binding KeyframeList}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Header="Selected" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding Timestamp}"
                    Header="Key frame"
                    IsReadOnly="True" />
            </DataGrid.Columns>
            <ib:Interaction.Triggers>
                <ib:EventTrigger EventName="MouseDoubleClick">
                    <ib:InvokeCommandAction Command="{Binding SeekToTimestampCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                </ib:EventTrigger>
            </ib:Interaction.Triggers>
        </DataGrid>

        <DockPanel
            Grid.Row="3"
            Grid.Column="1"
            Margin="5">
            <TextBlock
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Text="Volume:" />
            <Slider x:Name="VolumeSlider"
                Margin="5"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                IsMoveToPointEnabled="True"
                IsSnapToTickEnabled="True"
                Maximum="100"
                Minimum="0"
                Value="{Binding Volume, Mode=TwoWay}" />
        </DockPanel>
    </Grid>
</Window>