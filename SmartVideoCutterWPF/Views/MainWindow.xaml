<Window
    x:Class="SmartVideoCutterWPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="Smart video cutter"
    Width="800"
    Height="450"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Меню  -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem
                    Click="Open_Click"
                    Header="Открыть"
                    InputGestureText="Ctrl+O" />
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Click="Settings_Click" Header="Настройки" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" />
            </MenuItem>
        </Menu>

        <!--  Видео с оверлеем через VideoView.Content (аппаратно поверх видео)  -->
        <vlc:VideoView x:Name="VideoView" Grid.Row="1">
            <vlc:VideoView.Content>
                <Canvas x:Name="OverlayCanvas"
                    Background="Transparent"
                    IsHitTestVisible="False" />
            </vlc:VideoView.Content>
        </vlc:VideoView>

        <!--  Панель управления воспроизведением  -->
        <StackPanel
            Grid.Row="2"
            Margin="10"
            Orientation="Vertical">

            <!--  Ползунок перемотки  -->
            <Slider x:Name="TimeSlider"
                Margin="0,0,0,10"
                IsSnapToTickEnabled="True"
                Minimum="0"
                PreviewMouseDown="TimeSlider_PreviewMouseDown"
                PreviewMouseUp="TimeSlider_PreviewMouseUp" />

            <!--  Кнопки управления  -->
            <Grid>
                <StackPanel
                    Height="40"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal">
                    <Button x:Name="PlayPauseButton"
                        Width="90"
                        Margin="5"
                        Click="PlayPause_Click"
                        Content="Play/Pause" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="AnalyzeButton"
                        Width="90"
                        Margin="5"
                        Click="Analyze_Click"
                        Content="Analyze" />
                    <Button x:Name="ExportButton"
                        Width="90"
                        Margin="5"
                        Click="Export_Click"
                        Content="Export" />
                </StackPanel>
            </Grid>

        </StackPanel>

    </Grid>
</Window>