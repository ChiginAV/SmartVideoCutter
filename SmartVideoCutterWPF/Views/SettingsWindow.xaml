<Window
    MaxWidth="1024"
    MinWidth="600"
    SizeToContent="WidthAndHeight"
    Title="Settings"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d"
    x:Class="SmartVideoCutterWPF.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SmartVideoCutterWPF.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <!--  yolo  -->

        <TextBlock
            Margin="5"
            Padding="5"
            Text="Файл yolo:"
            VerticalAlignment="Center" />
        <TextBox
            Grid.Column="1"
            Margin="5"
            Name="txtYoloPath"
            Padding="5"
            Text="{Binding YoloPath}" />
        <Button
            Click="BrowseFileButton_Click"
            Content="Выбрать"
            Grid.Column="2"
            Margin="5"
            Tag="{Binding ElementName=txtYoloPath}" />

        <!--  arcface  -->

        <TextBlock
            Grid.Row="1"
            Margin="5"
            Padding="5"
            Text="Файл arcface:"
            VerticalAlignment="Center" />
        <TextBox
            Grid.Column="1"
            Grid.Row="1"
            Margin="5"
            Name="txtArcfacePath"
            Padding="5"
            Text="{Binding ArcFacePath}" />
        <Button
            Click="BrowseFileButton_Click"
            Content="Выбрать"
            Grid.Column="2"
            Grid.Row="1"
            Margin="5"
            Tag="{Binding ElementName=txtArcfacePath}" />

        <!--  ffmpeg  -->

        <TextBlock
            Grid.Row="2"
            Margin="5"
            Padding="5"
            Text="Папка ffmpeg:"
            VerticalAlignment="Center" />
        <TextBox
            Grid.Column="1"
            Grid.Row="2"
            Margin="5"
            Name="txtFfmpegPath"
            Padding="5"
            Text="{Binding FfmpegPath}" />
        <Button
            Click="BrowseFolderButton_Click"
            Content="Выбрать"
            Grid.Column="2"
            Grid.Row="2"
            Margin="5"
            Tag="{Binding ElementName=txtFfmpegPath}" />

        <!--  Save  -->

        <Button
            Click="Save_Click"
            Content="Сохранить"
            Grid.Column="1"
            Grid.Row="3"
            HorizontalAlignment="Center"
            Margin="5"
            Padding="5" />
    </Grid>
</Window>
