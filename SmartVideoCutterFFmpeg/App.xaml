<Application
    x:Class="SmartVideoCutterFFmpeg.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SmartVideoCutterFFmpeg.Converters"
    xmlns:local="clr-namespace:SmartVideoCutterFFmpeg"
    StartupUri="/Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Дефолтная тема (Light) + стили.
                    В App.xaml.cs словарь темы на позиции 0 заменяется на сохранённую
                    (Light/Dark). В WPF-дизайнере OnStartup не вызывается, поэтому
                    именно эти словари определяют внешний вид превью.
                -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:MillisecondsToTimeConverter x:Key="MsToTimeConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>