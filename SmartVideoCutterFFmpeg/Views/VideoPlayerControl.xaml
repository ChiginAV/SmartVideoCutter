<UserControl
    x:Class="SmartVideoCutterFFmpeg.Views.VideoPlayerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="480"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <!--  кадр  -->
            <RowDefinition Height="*" />
            <!--  панель управления  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Кадр (BitmapSource) + оверлей рамок лиц  -->
        <Border Grid.Row="0">
            <Grid x:Name="VideoGrid">
                <Image x:Name="VideoImage"
                    Source="{Binding VideoFrame}"
                    Stretch="Uniform" />
                <Canvas x:Name="FaceOverlay" />
            </Grid>
        </Border>

        <!--  Панель управления: Play/Pause, время, слайдер перемотки, длительность  -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton"
                Grid.Column="0"
                Margin="0,0,8,0"
                Command="{Binding PlayPauseCommand}"
                Content="Play / Pause" />

            <TextBlock
                Grid.Column="1"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="{Binding PositionMs, Converter={StaticResource MsToTimeConverter}}" />

            <Slider x:Name="PositionSlider"
                Grid.Column="2"
                VerticalAlignment="Center"
                IsEnabled="{Binding IsMediaLoaded}"
                LargeChange="5000"
                Maximum="{Binding DurationMs}"
                SmallChange="100"
                Value="{Binding PositionMs, Mode=OneWay}" />


            <TextBlock
                Grid.Column="3"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="{Binding DurationMs, Converter={StaticResource MsToTimeConverter}}" />
        </Grid>
    </Grid>
</UserControl>