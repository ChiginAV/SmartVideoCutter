<Window
    x:Class="SmartVideoCutterFFmpeg.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ib="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SmartVideoCutterFFmpeg.Views"
    Title="Smart video cutter"
    Width="1200"
    Height="720"
    MinWidth="800"
    MinHeight="600"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!--  меню  -->
            <RowDefinition Height="Auto" />
            <!--  командная панель  -->
            <RowDefinition Height="Auto" />
            <!--  видео плеер и список ключевых кадров  -->
            <RowDefinition Height="*" />
            <!--  статус-бар  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Меню  -->
        <Menu Grid.Row="0" Grid.ColumnSpan="2">
            <MenuItem Header="Файл">
                <MenuItem
                    Command="{Binding OpenFileCommand}"
                    Header="Открыть"
                    InputGestureText="Ctrl+O" />
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Command="{Binding OpenSettingsCommand}" Header="Настройки" />
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" />
            </MenuItem>
        </Menu>

        <!--  Командная панель  -->

        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Height="35"
            Margin="5"
            Orientation="Horizontal">
            <Button x:Name="AnalyzeButton"
                Margin="0,0,5,0"
                Command="{Binding AnalyzeFileCommand}"
                Content="Analyze" />
            <Button x:Name="ExportButton"
                Margin="0,0,5,0"
                Command="{Binding ExportFileCommand}"
                Content="Export" />
        </StackPanel>

        <!--  Видео плеер: кадр + рамки лиц + панель управления  -->

        <views:VideoPlayerControl Grid.Row="2" DataContext="{Binding Player}" />

        <!--  Список ключевых кадров видео  -->
        <Expander
            Grid.Row="2"
            Grid.Column="1"
            ExpandDirection="Left"
            IsExpanded="{Binding IsKeyframePanelExpanded, Mode=TwoWay}">
            <DataGrid
                Margin="0,0,5,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserSortColumns="False"
                DockPanel.Dock="Bottom"
                ItemsSource="{Binding KeyframeList}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="45"
                        Binding="{Binding Index}"
                        Header="#"
                        IsReadOnly="True" />
                    <DataGridCheckBoxColumn
                        Width="SizeToHeader"
                        Binding="{Binding IsSelected}"
                        Header="Selected" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Timestamp, Converter={StaticResource MsToTimeConverter}}"
                        Header="Key frame"
                        IsReadOnly="True" />
                </DataGrid.Columns>
                <ib:Interaction.Triggers>
                    <ib:EventTrigger EventName="MouseDoubleClick">
                        <ib:InvokeCommandAction Command="{Binding Player.SeekToTimestampCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    </ib:EventTrigger>
                </ib:Interaction.Triggers>
            </DataGrid>
        </Expander>

        <!--  статус-бар  -->

        <StatusBar
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Height="Auto">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

    </Grid>

</Window>