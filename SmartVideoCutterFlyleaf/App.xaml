<Application
    x:Class="SmartVideoCutterFlyleaf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SmartVideoCutterFlyleaf.Converters"
    ShutdownMode="OnMainWindowClose"
    StartupUri="/Views/MainWindow.xaml"
    ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <converters:MillisecondsToTimeConverter x:Key="MsToTimeConverter" />
            <!--  Тема добавляется программно в App.xaml.cs  -->
        </ResourceDictionary>
    </Application.Resources>
</Application>