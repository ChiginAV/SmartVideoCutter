<Window
    x:Class="SmartVideoCutterFlyleaf.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SmartVideoCutterFlyleaf.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    MinWidth="600"
    MaxWidth="1024"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <!--  yolo  -->

        <TextBlock
            Margin="5"
            Padding="5"
            VerticalAlignment="Center"
            Text="Файл yolo:" />
        <TextBox
            Grid.Column="1"
            Margin="5"
            Padding="5"
            Text="{Binding YoloPath}" />
        <Button
            Grid.Column="2"
            Margin="5"
            Command="{Binding BrowseFileCommand}"
            CommandParameter="YoloPath"
            Content="Выбрать" />

        <!--  arcface  -->

        <TextBlock
            Grid.Row="1"
            Margin="5"
            Padding="5"
            VerticalAlignment="Center"
            Text="Файл arcface:" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="5"
            Padding="5"
            Text="{Binding ArcFacePath}" />
        <Button
            Grid.Row="1"
            Grid.Column="2"
            Margin="5"
            Command="{Binding BrowseFileCommand}"
            CommandParameter="ArcFacePath"
            Content="Выбрать" />

        <!--  ffmpeg  -->

        <TextBlock
            Grid.Row="2"
            Margin="5"
            Padding="5"
            VerticalAlignment="Center"
            Text="Папка ffmpeg:" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="5"
            Padding="5"
            Text="{Binding FfmpegPath}" />
        <Button
            Grid.Row="2"
            Grid.Column="2"
            Margin="5"
            Command="{Binding BrowseFolderCommand}"
            CommandParameter="FfmpegPath"
            Content="Выбрать" />

        <!--  Save  -->

        <Button
            Grid.Row="3"
            Grid.Column="1"
            Margin="5"
            Padding="5"
            HorizontalAlignment="Center"
            Command="{Binding SaveCommand}"
            Content="Сохранить" />
    </Grid>
</Window>