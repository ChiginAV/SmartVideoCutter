<Window
    x:Class="SmartVideoCutter.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:SmartVideoCutter.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SmartVideoCutter.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    MinWidth="600"
    MaxWidth="1024"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:AnalysisAlgorithmDisplayNameConverter x:Key="AlgorithmNameConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>

        <!--  ffmpeg  -->

        <TextBlock
            Margin="5"
            Padding="5"
            VerticalAlignment="Center"
            Text="Папка ffmpeg:" />
        <TextBox
            Grid.Column="1"
            Margin="5"
            Padding="5"
            Text="{Binding Settings.FfmpegPath}" />
        <Button
            Grid.Column="2"
            Margin="5"
            Command="{Binding BrowseFfmpegFolderCommand}"
            Content="Выбрать" />

        <!--  тема  -->

        <TextBlock
            Grid.Row="1"
            Margin="5"
            Padding="5"
            VerticalAlignment="Center"
            Text="Тема оформления:" />
        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="150"
            Margin="5"
            HorizontalAlignment="Left"
            ItemsSource="{Binding ThemeModes}"
            SelectedItem="{Binding Settings.ThemeMode}" />

        <!--  алгоритм анализа  -->

        <TextBlock
            Grid.Row="2"
            Margin="5"
            Padding="5"
            VerticalAlignment="Center"
            Text="Алгоритм анализа:" />
        <ComboBox
            Grid.Row="2"
            Grid.Column="1"
            MinWidth="250"
            Margin="5"
            HorizontalAlignment="Left"
            ItemsSource="{Binding AnalysisAlgorithms}"
            SelectedItem="{Binding Settings.AnalysisAlgorithm}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource AlgorithmNameConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!--  Статус валидации  -->

        <TextBlock
            Grid.Row="3"
            Grid.ColumnSpan="3"
            Margin="5"
            Foreground="{DynamicResource DangerBrush}"
            Text="{Binding StatusMessage}"
            TextWrapping="Wrap" />

        <!--  Save  -->

        <Button
            Grid.Row="4"
            Grid.Column="1"
            Margin="5"
            Padding="5"
            HorizontalAlignment="Center"
            Command="{Binding SaveCommand}"
            Content="Сохранить" />
    </Grid>
</Window>
